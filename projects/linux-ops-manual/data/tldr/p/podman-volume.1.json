{"id":"podman-volume.1","lang":"en","desc":"Manage Podman volumes.","items":[["List local volumes","podman volume ls"],["Create a named volume","podman volume create {{volume_name}}"],["Export volume content to a `.tar` file","podman volume export {{[-o|--output]}} {{path/to/file.tar}} {{volume_name}}"],["Import tarball contents into an existing podman volume","podman volume import {{volume_name}} {{path/to/file.tar}}"],["Remove all unused volumes","podman volume prune {{[-a|--all]}}"]],"version":"v2.3","source":"https://github.com/tldr-pages/tldr/blob/main/pages/common/podman-volume.md"}