{"id":"flatpak-config.1","lang":"en","desc":"Manage configuration for Flatpak.","items":[["List all configuration settings","flatpak config --list"],["Display the value of a specific configuration setting","flatpak config --get {{key}}"],["Set a configuration setting","flatpak config --set {{key}} {{value}}"],["Remove a configuration setting","flatpak config --unset {{key}}"],["List system-wide configuration settings instead of per-user","flatpak config --system --list"]],"version":"v2.3","source":"https://github.com/tldr-pages/tldr/blob/main/pages/linux/flatpak-config.md"}