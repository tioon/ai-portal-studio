{"id":"sasldblistusers2.8","n":"sasldblistusers2","s":"8","src":{"r":{"pkg":"cyrus-sasl","ver":"2.1.27-21.el9","repo":"BaseOS","url":"https://dl.rockylinux.org/vault/rocky/9.6/BaseOS/x86_64/os/Packages/c/cyrus-sasl-2.1.27-21.el9.x86_64.rpm","path":"/usr/share/man/man8/sasldblistusers2.8.gz","sha256":"d8345d8cb2c4438a9d2478ca7d6f10d9cd90efe7c0876f58781a58f32a99fdf8","date":"March 7, 2005","origin":"CMU SASL"},"u":{"pkg":"sasl2-bin","ver":"2.1.27+dfsg2-3ubuntu1.2","repo":"jammy-updates/main","url":"http://archive.ubuntu.com/ubuntu/pool/main/c/cyrus-sasl2/sasl2-bin_2.1.27+dfsg2-3ubuntu1.2_amd64.deb","path":"/usr/share/man/man8/sasldblistusers2.8.gz","sha256":"ef0ea3728d6c3290710a1eeb054c757ee4be40b3d4fc924686f863271795880d","date":"March 7, 2005","origin":"CMU SASL"}},"nopt":{"r":2,"u":2},"desc":"list users in sasldb","same":true,"doc":[["NAME","<p>sasldblistusers2 - list users in sasldb</p>"],["SYNOPSIS","<p><b>sasldblistusers2</b> [<b>-f file</b>] [<b>-v</b>]</p>"],["DESCRIPTION","<p><i>sasldblistusers2</i> is used to list the users in the SASL password database (usually /etc/sasldb2). This will NOT list all the users in /etc/passwd, shadow, PAM, etc. only those created by SASL (via <i>saslpasswd2</i>).</p>"],["OPTIONS","<dl><dt data-o=\"\"><b>-f file</b></dt><dd>use <b>file</b> for sasldb</dd><dt data-o=\"\"><b>-v</b></dt><dd>Print libsasl2 version number and exit.</dd></dl>"],["SEE ALSO","<p>saslpasswd2(8)</p> <dl><dt>rfc4422 - Simple Authentication and Security Layer (SASL)</dt><dd></dd></dl>"]]}