{"id":"sbverify.1","n":"sbverify","s":"1","src":{"u":{"pkg":"sbsigntool","ver":"0.9.4-2ubuntu2","repo":"jammy/main","url":"http://archive.ubuntu.com/ubuntu/pool/main/s/sbsigntool/sbsigntool_0.9.4-2ubuntu2_amd64.deb","path":"/usr/share/man/man1/sbverify.1.gz","sha256":"2ce0efe5a6bfc069e7e412d077cf6feebd2f1b2a486cd53d91a93917a0c6aecd","date":"November 2021","origin":"sbverify 0.9.4"}},"nopt":{"u":3},"desc":"UEFI secure boot verification tool","u":[["NAME","<p>sbverify - UEFI secure boot verification tool</p>"],["SYNOPSIS","<p><b>sbverify</b> [<i>options</i>] <i>--cert &lt;certfile&gt; &lt;efi-boot-image&gt;</i></p>"],["DESCRIPTION","<p>Verify a UEFI secure boot image.</p>"],["OPTIONS","<dl><dt data-o=\"\"><b>--cert</b> &lt;certfile&gt;</dt><dd>certificate (x509 certificate)</dd><dt data-o=\"\"><b>--list</b></dt><dd>list all signatures (but don't verify)</dd><dt data-o=\"\"><b>--detached</b> &lt;file&gt;</dt><dd>read signature from &lt;file&gt;, instead of looking for an embedded signature</dd></dl>"]]}