{"id":"hashstats.8","n":"hashstats","s":"8","src":{"r":{"pkg":"duperemove","ver":"0.11.3-2.el9","repo":"EPEL","url":"https://dl.fedoraproject.org/pub/epel/9/Everything/x86_64/Packages/d/duperemove-0.11.3-2.el9.x86_64.rpm","path":"/usr/share/man/man8/hashstats.8.gz","sha256":"4993315457dd90442322b719e51f60e3c35499063f61d982bc2514eacff61736","date":"October 2015","origin":"Version 0.10"},"u":{"pkg":"duperemove","ver":"0.11.2-3","repo":"jammy/universe","url":"http://archive.ubuntu.com/ubuntu/pool/universe/d/duperemove/duperemove_0.11.2-3_amd64.deb","path":"/usr/share/man/man8/hashstats.8.gz","sha256":"618dd87989af229392b2744ac93a71c8f211553b523dcc063bc9d54287afad90","date":"October 2015","origin":"Version 0.10"}},"nopt":{"r":4,"u":4},"desc":"Print information about a duperemove hashfile","same":true,"doc":[["NAME","<p>hashstats - Print information about a duperemove hashfile</p>"],["SYNOPSIS","<p><b>hashstats</b> <i>[options]</i> <i>hashfile</i></p>"],["DESCRIPTION","<p><i>hashfile</i> should be a file generated by running duperemove with the --hashfile or --write-hashes option.</p>"],["OPTIONS","<dl><dt data-o=\"\"><b>-n NUM</b></dt><dd>Print top <i>NUM</i> hashes, sorted by bucket size. Default is 10.</dd><dt data-o=\"\"><b>-a</b></dt><dd>Print all hashes (overrides <b>-n</b>, above)</dd><dt data-o=\"\"><b>-b</b></dt><dd>Print info on each block within our hash buckets.</dd><dt data-o=\"\"><b>-l</b></dt><dd>Print a list of all files</dd></dl>"],["SEE ALSO","<p><b>duperemove(8)</b></p>"]]}