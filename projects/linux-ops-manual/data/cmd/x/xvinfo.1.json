{"id":"xvinfo.1","n":"xvinfo","s":"1","src":{"r":{"pkg":"xorg-x11-utils","ver":"7.5-40.el9","repo":"AppStream","url":"https://dl.rockylinux.org/vault/rocky/9.6/AppStream/x86_64/os/Packages/x/xorg-x11-utils-7.5-40.el9.x86_64.rpm","path":"/usr/share/man/man1/xvinfo.1.gz","sha256":"9e17b1311d933e8707be20c92eaa9a7b40e9985ddc65b8f6d5e485dd3df85076","date":"xvinfo 1.1.3","origin":"X Version 11"},"u":{"pkg":"x11-utils","ver":"7.7+5build2","repo":"jammy/main","url":"http://archive.ubuntu.com/ubuntu/pool/main/x/x11-utils/x11-utils_7.7+5build2_amd64.deb","path":"/usr/share/man/man1/xvinfo.1.gz","sha256":"d294ae7786094512e84ef5c66ba55c6926df263da6271e421cbb309eae7f6317","date":"xvinfo 1.1.4","origin":"X Version 11"}},"nopt":{"r":3,"u":3},"desc":"Print out X-Video extension adaptor information","same":true,"doc":[["NAME","<p>xvinfo - Print out X-Video extension adaptor information</p>"],["SYNOPSIS","<p><b>xvinfo</b> [-display <i>displayname</i>]</p>"],["DESCRIPTION","<p><b>xvinfo</b> prints out the capabilities of any video adaptors associated with the display that are accessible through the X-Video extension.</p>"],["OPTIONS","<dl><dt data-o=\"\"><b>-display <i>display</i></b></dt><dd>This argument allows you to specify the server to query; see <i>X(7)</i>.</dd><dt data-o=\"\"><b>-short</b></dt><dd>Output less details, to reduce the amount of text.</dd><dt data-o=\"\"><b>-version</b></dt><dd>Output program version, then exit.</dd></dl>"],["ENVIRONMENT","<dl><dt><b>DISPLAY</b></dt><dd>This variable may be used to specify the server to query.</dd></dl>"],["SEE ALSO","<p>X(7), xdpyinfo(1), xwininfo(1), xdriinfo(1), glxinfo(1), xprop(1)</p>"],["AUTHORS","<p>Mark Vojkovich</p>"]]}