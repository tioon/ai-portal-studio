{"id":"ownership.8","n":"ownership","s":"8","src":{"r":{"pkg":"dmidecode","ver":"3.6-1.el9","repo":"BaseOS","url":"https://dl.rockylinux.org/vault/rocky/9.6/BaseOS/x86_64/os/Packages/d/dmidecode-3.6-1.el9.x86_64.rpm","path":"/usr/share/man/man8/ownership.8.gz","sha256":"88f6349e0ee0beae2bcc11b17b3e024f02fedb9bc6144741f257053a95370a0d","date":"February 2005","origin":"dmidecode"},"u":{"pkg":"dmidecode","ver":"3.3-3ubuntu0.2","repo":"jammy-updates/main","url":"http://archive.ubuntu.com/ubuntu/pool/main/d/dmidecode/dmidecode_3.3-3ubuntu0.2_amd64.deb","path":"/usr/share/man/man8/ownership.8.gz","sha256":"336814f369929efd6a80897ddd9af0aa02a00e1edb5c7ff4e9bd312b42d67741","date":"February 2005","origin":"dmidecode"}},"nopt":{"r":3,"u":3},"desc":"Compaq ownership tag retriever","same":false,"r":[["NAME","<p>ownership - Compaq ownership tag retriever</p>"],["SYNOPSIS","<p><b>ownership</b> [<i>OPTIONS</i>]</p>"],["DESCRIPTION","<p><b>ownership</b> retrieves and prints the \"ownership tag\" that can be set on Compaq computers. Contrary to all other programs of the <b>dmidecode</b> package, <b>ownership</b> doesn't print any version information, nor labels, but only the raw ownership tag. This should help its integration in scripts.</p>"],["OPTIONS","<dl><dt data-o=\"\"><b>-d</b>, <b>--dev-mem <i>FILE</i></b></dt><dd>Read memory from device <i>FILE</i> (default: <i>/dev/mem</i>)</dd><dt data-o=\"\"><b>-h</b>, <b>--help</b></dt><dd>Display usage information and exit</dd><dt data-o=\"\"><b>-V</b>, <b>--version</b></dt><dd>Display the version and exit</dd></dl>"],["FILES","<p><i>/dev/mem</i></p>"],["AUTHOR","<p>Jean Delvare</p>"],["SEE ALSO","<p><b>biosdecode</b>(8), <b>dmidecode</b>(8), <b>mem</b>(4), <b>vpddecode</b>(8)</p>"]],"u":[["NAME",0],["SYNOPSIS","<p><b>ownership</b> [<b>OPTIONS</b>]</p>"],["DESCRIPTION",2],["OPTIONS","<dl><dt data-o=\"\"><b>-d</b>, <b>--dev-mem FILE</b></dt><dd>Read memory from device <b>FILE</b> (default: <b>/dev/mem</b>)</dd><dt data-o=\"\"><b>-h</b>, <b>--help</b></dt><dd>Display usage information and exit</dd><dt data-o=\"\"><b>-V</b>, <b>--version</b></dt><dd>Display the version and exit</dd></dl>"],["FILES",4],["AUTHOR",5],["SEE ALSO",6]],"diff":{"r":[],"u":[]}}