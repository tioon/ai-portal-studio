{"id":"perf-kallsyms.1","n":"perf-kallsyms","s":"1","src":{"r":{"pkg":"perf","ver":"5.14.0-570.58.1.el9_6","repo":"AppStream","url":"https://dl.rockylinux.org/vault/rocky/9.6/AppStream/x86_64/os/Packages/p/perf-5.14.0-570.58.1.el9_6.x86_64.rpm","path":"/usr/share/man/man1/perf-kallsyms.1.gz","sha256":"033d18f3bf8002c24628fdfca3f0b128f42a1bf48fa50ac4878f2ec12a642d72","date":"10/30/2025","origin":"perf"},"u":{"pkg":"linux-tools-common","ver":"5.15.0-204.214","repo":"jammy-updates/main","url":"http://archive.ubuntu.com/ubuntu/pool/main/l/linux/linux-tools-common_5.15.0-204.214_all.deb","path":"/usr/share/man/man1/perf-kallsyms.1.gz","sha256":"9764e1e1c97844ed1e12dd12ac8918e4e04e1ba682f01f7b04a5b8741f21599e","date":"11/06/2026","origin":"perf","also":["linux-intel-iotg-tools-common"]}},"nopt":{"r":1,"u":1},"desc":"Searches running kernel for symbols","same":true,"doc":[["NAME","<p>perf-kallsyms - Searches running kernel for symbols</p>"],["SYNOPSIS","<pre><i>perf kallsyms</i> [&lt;options&gt;] symbol_name[,symbol_name...]</pre>"],["DESCRIPTION","<p>This command searches the running kernel kallsyms file for the given symbol(s) and prints information about it, including the DSO, the kallsyms begin/end addresses and the addresses in the ELF kallsyms symbol table (for symbols in modules).</p>"],["OPTIONS","<dl><dt data-o=\"\">-v, --verbose</dt><dd>Increase verbosity level, showing details about symbol table loading, etc.</dd></dl>"]]}