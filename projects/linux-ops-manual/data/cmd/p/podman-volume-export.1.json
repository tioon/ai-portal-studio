{"id":"podman-volume-export.1","n":"podman-volume-export","s":"1","src":{"r":{"pkg":"podman","ver":"5.4.0-13.el9_6","repo":"AppStream","url":"https://dl.rockylinux.org/vault/rocky/9.6/AppStream/x86_64/os/Packages/p/podman-5.4.0-13.el9_6.x86_64.rpm","path":"/usr/share/man/man1/podman-volume-export.1.gz","sha256":"d94fed2b255a77f5f3f94c88e598fd44b8ab9df19f809fbefc477184ad8ca9c7","date":"","origin":""},"u":{"pkg":"podman","ver":"3.4.4+ds1-1ubuntu1.22.04.3","repo":"jammy-updates/universe","url":"http://archive.ubuntu.com/ubuntu/pool/universe/libp/libpod/podman_3.4.4+ds1-1ubuntu1.22.04.3_amd64.deb","path":"/usr/share/man/man1/podman-volume-export.1.gz","sha256":"d6166c00d893b212d30e03b49cac3568bb4b46452b94c8d92e8b291ed5b6b953","date":"","origin":""}},"nopt":{"r":0,"u":0},"desc":"Export volume to external tar","same":false,"r":[["NAME","<p>podman-volume-export - Export volume to external tar</p>"],["SYNOPSIS","<p><b>podman volume export</b> [<i>options</i>] <i>volume</i></p>"],["DESCRIPTION","<p><b>podman volume export</b> exports the contents of a podman volume and saves it as a tarball on the local machine. <b>podman volume export</b> writes to STDOUT by default and can be redirected to a file using the <b>--output</b> flag.</p>  <p>Note: Following command is not supported by podman-remote.</p>  <p><b>podman volume export [OPTIONS] VOLUME</b></p>"],["OPTIONS","<h3>--help</h3> <p>Print usage statement</p>    <h3>--output, -o=file</h3> <p>Write to a file, default is STDOUT</p>"],["EXAMPLES","<p>Export named volume content into the specified file.</p>  <pre>$ podman volume export myvol --output myvol.tar\n</pre>"],["SEE ALSO","<p><b>podman(1)</b>, <b>podman-volume(1)</b>, <b>podman-volume-import(1)</b></p>"]],"u":[["NAME","<p>podman-volume-export - Exports volume to external tar</p>"],["SYNOPSIS",1],["DESCRIPTION",2],["OPTIONS","<h3>--output, -o=file</h3> <p>Write to a file, default is STDOUT</p>    <h3>--help</h3> <p>Print usage statement</p>"],["EXAMPLES","<div class=\"in\">  <pre>$ podman volume export myvol --output myvol.tar\n</pre> </div>"],["SEE ALSO","<p>podman-volume(1), podman-volume-import(1)</p>"]],"diff":{"r":[],"u":[]}}