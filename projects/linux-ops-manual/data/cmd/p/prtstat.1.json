{"id":"prtstat.1","n":"prtstat","s":"1","src":{"r":{"pkg":"psmisc","ver":"23.4-3.el9","repo":"BaseOS","url":"https://dl.rockylinux.org/vault/rocky/9.6/BaseOS/x86_64/os/Packages/p/psmisc-23.4-3.el9.x86_64.rpm","path":"/usr/share/man/man1/prtstat.1.gz","sha256":"c6bb80487a9518ffd9956018f7577f93d011d28077ca4453a97701a181269745","date":"2020-09-09","origin":"psmisc"},"u":{"pkg":"psmisc","ver":"23.4-2build3","repo":"jammy/main","url":"http://archive.ubuntu.com/ubuntu/pool/main/p/psmisc/psmisc_23.4-2build3_amd64.deb","path":"/usr/share/man/man1/prtstat.1.gz","sha256":"1a80865692d657a3244b69907baa3a59051848ccd373121f183de466689a2b81","date":"2020-09-09","origin":"psmisc"}},"nopt":{"r":2,"u":2},"desc":"print statistics of a process","same":true,"doc":[["NAME","<p>prtstat - print statistics of a process</p>"],["SYNOPSIS","<p><b>prtstat</b> [<b>-r</b>|<b>--raw</b>] <i>pid</i> <br> <b>prtstat</b> <b>-V</b>|<b>--version</b></p>"],["DESCRIPTION","<p><b>prtstat</b> prints the statistics of the specified process. This information comes from the <b>/proc/</b><i>pid</i><b>/stat</b> file.</p>"],["OPTIONS","<dl><dt data-o=\"\"><b>-r</b>,<b> --raw</b></dt><dd>Print the information in raw format.</dd><dt data-o=\"\"><b>-V</b>,<b> --version</b></dt><dd>Show the version information for <b>prtstat</b>.</dd></dl>"],["FILES","<dl><dt><b>/proc/</b><i>pid</i><b>/stat</b></dt><dd>source of the information <b>prtstat</b> uses.</dd></dl>"]]}