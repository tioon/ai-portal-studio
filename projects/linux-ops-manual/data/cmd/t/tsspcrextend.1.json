{"id":"tsspcrextend.1","n":"tsspcrextend","s":"1","src":{"r":{"pkg":"tss2","ver":"1.6.0-7.el9","repo":"BaseOS","url":"https://dl.rockylinux.org/vault/rocky/9.6/BaseOS/x86_64/os/Packages/t/tss2-1.6.0-7.el9.x86_64.rpm","path":"/usr/share/man/man1/tsspcrextend.1.gz","sha256":"61d70bdd45bb8fecbcde1161a4fb93abebdd88abd7d05cac353848b5acc927c8","date":"November 2020","origin":"tsspcrextend 1.6"}},"nopt":{"r":4},"desc":"Runs TPM2 pcrextend","r":[["NAME","<p>tsspcrextend - Runs TPM2 pcrextend</p>"],["DESCRIPTION","<p>pcrextend</p> <p>Runs TPM2_PCR_Extend</p> <dl><dt data-o=\"\"><b>-ha</b></dt><dd>pcr handle</dd><dt data-o=\"\">[-halg</dt><dd>(sha1, sha256, sha384, sha512) (default sha256)] <b>-halg</b> may be specified more than once</dd><dt data-o=\"\"><b>-ic</b></dt><dd>data string, 0 pad appended to halg length</dd><dt data-o=\"\"><b>-if</b></dt><dd>data file, 0 pad appended to halg length</dd></dl>"]]}