{"id":"tsspolicyauthorizenv.1","n":"tsspolicyauthorizenv","s":"1","src":{"r":{"pkg":"tss2","ver":"1.6.0-7.el9","repo":"BaseOS","url":"https://dl.rockylinux.org/vault/rocky/9.6/BaseOS/x86_64/os/Packages/t/tss2-1.6.0-7.el9.x86_64.rpm","path":"/usr/share/man/man1/tsspolicyauthorizenv.1.gz","sha256":"61d70bdd45bb8fecbcde1161a4fb93abebdd88abd7d05cac353848b5acc927c8","date":"November 2020","origin":"tsspolicyauthorizenv 1.6"}},"nopt":{"r":4},"desc":"Runs TPM2 policyauthorizenv","r":[["NAME","<p>tsspolicyauthorizenv - Runs TPM2 policyauthorizenv</p>"],["DESCRIPTION","<p>policyauthorizenv</p> <p>Runs TPM2_PolicyAuthorizeNV</p> <dl><dt data-o=\"\">[-hi</dt><dd>hierarchy authHandle (o, p)] default NV index</dd><dt data-o=\"\"><b>-ha</b></dt><dd>NV index handle</dd><dt data-o=\"\">[-pwda</dt><dd>password for authorization (default empty)]</dd><dt data-o=\"\"><b>-hs</b></dt><dd>policy session handle</dd></dl> <p><b>-se[0-2]</b> session handle / attributes (default PWAP)</p> <dl><dt>01</dt><dd>continue</dd></dl>"]]}