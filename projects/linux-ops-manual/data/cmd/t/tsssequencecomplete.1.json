{"id":"tsssequencecomplete.1","n":"tsssequencecomplete","s":"1","src":{"r":{"pkg":"tss2","ver":"1.6.0-7.el9","repo":"BaseOS","url":"https://dl.rockylinux.org/vault/rocky/9.6/BaseOS/x86_64/os/Packages/t/tss2-1.6.0-7.el9.x86_64.rpm","path":"/usr/share/man/man1/tsssequencecomplete.1.gz","sha256":"61d70bdd45bb8fecbcde1161a4fb93abebdd88abd7d05cac353848b5acc927c8","date":"November 2020","origin":"tsssequencecomplete 1.6"}},"nopt":{"r":5},"desc":"Runs TPM2 sequencecomplete","r":[["NAME","<p>tsssequencecomplete - Runs TPM2 sequencecomplete</p>"],["DESCRIPTION","<p>sequencecomplete</p> <p>Runs TPM2_SequenceComplete</p> <dl><dt data-o=\"\"><b>-hs</b></dt><dd>sequence handle</dd><dt data-o=\"\">[-pwds</dt><dd>password for sequence (default empty)]</dd><dt data-o=\"\">[-if</dt><dd>input file to be added (default no data)]</dd><dt data-o=\"\">[-of</dt><dd>result file name]</dd><dt data-o=\"\">[-tk</dt><dd>ticket file name]</dd></dl> <p><b>-se[0-2]</b> session handle / attributes (default PWAP)</p> <dl><dt>01</dt><dd>continue</dd><dt>20</dt><dd>command decrypt</dd><dt>40</dt><dd>response encrypt</dd></dl>"]]}