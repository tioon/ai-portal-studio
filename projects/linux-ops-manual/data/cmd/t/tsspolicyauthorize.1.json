{"id":"tsspolicyauthorize.1","n":"tsspolicyauthorize","s":"1","src":{"r":{"pkg":"tss2","ver":"1.6.0-7.el9","repo":"BaseOS","url":"https://dl.rockylinux.org/vault/rocky/9.6/BaseOS/x86_64/os/Packages/t/tss2-1.6.0-7.el9.x86_64.rpm","path":"/usr/share/man/man1/tsspolicyauthorize.1.gz","sha256":"61d70bdd45bb8fecbcde1161a4fb93abebdd88abd7d05cac353848b5acc927c8","date":"November 2020","origin":"tsspolicyauthorize 1.6"}},"nopt":{"r":5},"desc":"Runs TPM2 policyauthorize","r":[["NAME","<p>tsspolicyauthorize - Runs TPM2 policyauthorize</p>"],["DESCRIPTION","<p>policyauthorize</p> <p>Runs TPM2_PolicyAuthorize</p> <dl><dt data-o=\"\"><b>-ha</b></dt><dd>policy session handle</dd><dt data-o=\"\"><b>-appr</b></dt><dd>file name of digest of the policy being approved</dd><dt data-o=\"\">[-pref</dt><dd>policyRef file] (default none)</dd><dt data-o=\"\"><b>-skn</b></dt><dd>signing key Name file name</dd><dt data-o=\"\"><b>-tk</b></dt><dd>ticket file name</dd></dl> <p><b>-se[0-2]</b> session handle / attributes (default NULL)</p> <dl><dt>20</dt><dd>command decrypt</dd><dt>01</dt><dd>continue</dd></dl>"]]}