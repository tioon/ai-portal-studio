{"id":"txt-stat.8","n":"txt-stat","s":"8","src":{"r":{"pkg":"tboot","ver":"1.11.9-1.el9","repo":"BaseOS","url":"https://dl.rockylinux.org/vault/rocky/9.6/BaseOS/x86_64/os/Packages/t/tboot-1.11.9-1.el9.x86_64.rpm","path":"/usr/share/man/man8/txt-stat.8.gz","sha256":"722b46591318682f9917c4e72b8686fc5c753bdd58af4fd06028dc1e80889d0b","date":"2011-12-31","origin":"tboot"}},"nopt":{"r":2},"desc":"display the status of TXT","r":[["NAME","<p>txt-stat - display the status of TXT</p>"],["SYNOPSIS","<p><b>txt-stat</b> [<b>--heap</b>] [<b>-h</b>]</p>"],["DESCRIPTION","<p><b>txt-stat</b> is used to display various information about the status of Intel(R) TXT. It will display the TXT configuration registers status and TBOOT log by default.</p>"],["OPTIONS","<dl><dt data-o=\"\"><b>--heap</b></dt><dd>Print out the BiosData structure from the TXT heap.</dd><dt data-o=\"\"><b>-h</b>, <b>--help</b></dt><dd>Print out this help message.</dd></dl>"],["EXAMPLES","<p><b>txt-stat --heap</b></p>"]]}