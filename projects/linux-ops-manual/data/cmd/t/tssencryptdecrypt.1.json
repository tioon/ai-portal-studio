{"id":"tssencryptdecrypt.1","n":"tssencryptdecrypt","s":"1","src":{"r":{"pkg":"tss2","ver":"1.6.0-7.el9","repo":"BaseOS","url":"https://dl.rockylinux.org/vault/rocky/9.6/BaseOS/x86_64/os/Packages/t/tss2-1.6.0-7.el9.x86_64.rpm","path":"/usr/share/man/man1/tssencryptdecrypt.1.gz","sha256":"61d70bdd45bb8fecbcde1161a4fb93abebdd88abd7d05cac353848b5acc927c8","date":"November 2020","origin":"tssencryptdecrypt 1.6"}},"nopt":{"r":6},"desc":"Runs TPM2 encryptdecrypt","r":[["NAME","<p>tssencryptdecrypt - Runs TPM2 encryptdecrypt</p>"],["DESCRIPTION","<p>encryptdecrypt</p> <p>Runs TPM2_EncryptDecrypt</p> <dl><dt data-o=\"\"><b>-hk</b></dt><dd>key handle</dd><dt data-o=\"\"><b>-pwdk</b></dt><dd>password for key (default empty)</dd><dt data-o=\"\"><b>-d</b></dt><dd>decrypt (default encrypt)</dd><dt data-o=\"\"><b>-if</b></dt><dd>input file name</dd><dt data-o=\"\">[-of</dt><dd>output file name (default do not save)]</dd><dt data-o=\"\">[-2</dt><dd>use TPM2_EncryptDecrypt2]</dd></dl> <p><b>-se[0-2]</b> session handle / attributes (default PWAP)</p> <dl><dt>01</dt><dd>continue</dd><dt>20</dt><dd>command decrypt</dd><dt>40</dt><dd>response encrypt</dd></dl>"]]}