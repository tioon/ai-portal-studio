{"id":"tssdictionaryattackparameters.1","n":"tssdictionaryattackparameters","s":"1","src":{"r":{"pkg":"tss2","ver":"1.6.0-7.el9","repo":"BaseOS","url":"https://dl.rockylinux.org/vault/rocky/9.6/BaseOS/x86_64/os/Packages/t/tss2-1.6.0-7.el9.x86_64.rpm","path":"/usr/share/man/man1/tssdictionaryattackparameters.1.gz","sha256":"61d70bdd45bb8fecbcde1161a4fb93abebdd88abd7d05cac353848b5acc927c8","date":"November 2020","origin":"tssdictionaryattackparameters 1.6"}},"nopt":{"r":4},"desc":"Runs TPM2 dictionaryattackparameters","r":[["NAME","<p>tssdictionaryattackparameters - Runs TPM2 dictionaryattackparameters</p>"],["DESCRIPTION","<p>dictionaryattackparameters</p> <p>Runs TPM2_DictionaryAttackParameters</p> <dl><dt data-o=\"\">[-pwd</dt><dd>lockout auth password (default empty)]</dd><dt data-o=\"\">[-nmt</dt><dd>new max tries (default 1 try)]</dd><dt data-o=\"\">[-nrt</dt><dd>new recovery time (default 10 seconds)]</dd><dt data-o=\"\">[-lr</dt><dd>lockout recovery (default 1 second)]</dd></dl> <p><b>-se[0-2]</b> session handle / attributes (default PWAP)</p> <dl><dt>01</dt><dd>continue</dd></dl>"]]}